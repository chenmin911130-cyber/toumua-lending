# Local development only. Never commit real secrets or Railway credentials.
NODE_ENV=development
API_PORT=3001
PUBLIC_WEB_URL=http://127.0.0.1:5173
WEB_PORT=5173

# Homebrew PostgreSQL 16 on this machine. Docker Compose uses the same names
# with user/password postgres/postgres on port 5432.
DATABASE_URL=postgresql://minchen@127.0.0.1:5432/toumua_dev
TEST_DATABASE_URL=postgresql://minchen@127.0.0.1:5432/toumua_test

SESSION_SECRET=replace-with-a-long-random-session-secret
CSRF_SECRET=replace-with-a-long-random-csrf-secret
COOKIE_SECURE=false

# Created once on boot if no manage_staff account exists. No cash role.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Workspace Admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin12

# smtp -> Mailpit (dev). memory -> tests. Do not fake production send success.
MAIL_DRIVER=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_FROM=noreply@toumua.lending

VERIFY_TTL_HOURS=24
RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72
RESEND_INTERVAL_SECONDS=60

# C07 contact. Leave blank to show "not configured" — do not invent numbers.
CONTACT_PHONE=021 150 1502
CONTACT_EMAIL=office@toumua.lending
CONTACT_ADDRESS=Auckland, New Zealand
CONTACT_HOURS=Monday–Friday, 9:00am–5:00pm NZST
CONTACT_NOTE=Demo office mailbox for the COMP721 Toumu’a Lending workspace.

# Demo money math until Alice supplies the official formula.
# test = zero-interest acceptance fixture. demo = simple interest. off = block approvals.
CALCULATION_POLICY=demo
# 2100 = 21.00% p.a. simple interest, same ballpark as the homepage estimate.
DEMO_ANNUAL_RATE_BPS=2100
