generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BusinessRole {
  CUSTOMER
  LOAN_OFFICER
  VALUATION_OFFICER
  MANAGER
  CASHIER
  ACCOUNTANT
  OWNER
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INVITED
  INACTIVE
  INVITATION_REVOKED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITATION
}

enum MailStatus {
  QUEUED
  ACCEPTED
  FAILED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DECLINED
}

enum ApplicationStep {
  BORROWER
  LOAN_DETAILS
  SECURITY
  TERMS
  REVIEW
}

enum ValuationStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
}

enum AccountLinkStatus {
  ACTIVE
  REVOKED
}

enum LoanStatus {
  APPROVED_UNFUNDED
  ACTIVE
  SETTLED
  DEFAULTED
}

enum AssetStatus {
  PROPOSED
  VALUED
  STORED
  RETURNED
  SOLD
}

enum CustodyEventType {
  RECEIVED
  INSPECTED
  STORED
  RELOCATED
  RETURNED
  SOLD
}

enum StorageLocationKind {
  SAFE
  LOCKED_CABINET
  SHELF
  SECURE_YARD
  OFFSITE
}

enum ScheduleEntryStatus {
  PENDING
  PAID
}

enum PaymentAttemptType {
  DISBURSEMENT
  REPAYMENT
  SALE_RECEIPT
}

enum CorrectionStatus {
  REQUESTED
  APPROVED
  REJECTED
  POSTED
}

/// UNKNOWN is deliberately distinct from REJECTED: a timeout is never proof that
/// no money moved, so only a REJECTED attempt without a posting may be retried.
enum PaymentAttemptStatus {
  PENDING
  COMMITTED
  REJECTED
  UNKNOWN
}

enum LedgerEntryType {
  DISBURSEMENT
  REPAYMENT
  SALE_RECEIPT
}

model User {
  id              String       @id @default(cuid())
  email           String
  emailNormalized String       @unique
  passwordHash    String?
  name            String
  role            BusinessRole?
  status          UserStatus
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions          Session[]
  tokens            VerificationToken[]
  permissions       StaffPermission[]
  sentInvitations   Invitation[]        @relation("InvitedBy")
  receivedInvitation Invitation?
  auditEvents       AuditEvent[]
  mailMessages      MailMessage[]
  borrowersCreated  Borrower[]            @relation("BorrowerCreatedBy")
  accountLinksLinked BorrowerAccountLink[] @relation("LinkLinkedBy")
  customerLinks     BorrowerAccountLink[] @relation("LinkUser")
  applicationsCreated Application[]       @relation("ApplicationCreatedBy")
  valuationsAsLoanOfficer Valuation[]     @relation("ValuationLoanOfficer")
  valuationsAsValuationOfficer Valuation[] @relation("ValuationOfficer")
  decisionsMade     ApplicationDecision[] @relation("DecisionBy")
  loansDisbursed    Loan[]                @relation("LoanDisbursedBy")
  loansDefaulted    Loan[]                @relation("LoanDefaultedBy")
  custodyRecorded   CustodyEvent[]        @relation("CustodyRecordedBy")
  ledgerPosted      LedgerEntry[]         @relation("LedgerPostedBy")
  paymentAttempts   PaymentAttempt[]      @relation("PaymentAttemptBy")
  receiptsIssued    Receipt[]             @relation("ReceiptIssuedBy")
  correctionsRequested CorrectionRequest[] @relation("CorrectionRequestedBy")
  correctionsDecided  CorrectionRequest[]   @relation("CorrectionDecidedBy")
  notifications       Notification[]
  documentsUploaded   Document[]            @relation("DocumentUploadedBy")
  contractsWitnessed  LoanContract[]        @relation("ContractWitness")
  arrangementsRequested RepaymentArrangement[] @relation("ArrangementRequestedBy")
  arrangementsActivated RepaymentArrangement[] @relation("ArrangementActivatedBy")
  arrangementsConsented RepaymentArrangement[] @relation("ArrangementConsentedBy")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  restricted Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Invitation {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  role        BusinessRole
  email       String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model StaffPermission {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String

  @@unique([userId, permission])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  objectType String
  objectId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([objectType, objectId])
}

model MailMessage {
  id                String     @id @default(cuid())
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail           String
  subject           String
  textBody          String
  htmlBody          String
  status            MailStatus @default(QUEUED)
  providerAccepted  Boolean    @default(false)
  error             String?
  createdAt         DateTime   @default(now())
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model SequenceCounter {
  key   String @id
  value Int    @default(0)
}

model Borrower {
  id          String   @id @default(cuid())
  number      String   @unique
  name        String
  salutation  String?
  email       String?
  phone       String
  address     String
  notes       String?
  smsOptIn    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("BorrowerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  accountLinks BorrowerAccountLink[]
  loans        Loan[]
  smsMessages  SmsMessage[]
  documents    Document[]

  @@index([name])
  @@index([phone])
}

model BorrowerAccountLink {
  id                 String            @id @default(cuid())
  borrowerId         String
  borrower           Borrower          @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation("LinkUser", fields: [userId], references: [id], onDelete: Cascade)
  status             AccountLinkStatus @default(ACTIVE)
  verificationMethod String
  notes              String?
  linkedById         String?
  linkedBy           User?             @relation("LinkLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)
  revokedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId, status])
  @@index([borrowerId, status])
}

model Application {
  id                 String            @id @default(cuid())
  number             String            @unique
  borrowerId         String?
  borrower           Borrower?         @relation(fields: [borrowerId], references: [id], onDelete: SetNull)
  status             ApplicationStatus @default(DRAFT)
  currentStep        ApplicationStep   @default(BORROWER)
  version            Int               @default(1)
  requestedAmount    String?
  purpose            String?
  purposeDescription String?
  proposedTermMonths Int?
  createdById        String
  createdBy          User              @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  submittedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  assets     ApplicationAsset[]
  terms      ApplicationTerms?
  valuations Valuation[]
  decisions  ApplicationDecision[]
  loan       Loan?

  @@index([status, updatedAt])
  @@index([borrowerId])
}

/// Append-only record of the manager decision taken against a submitted snapshot.
model ApplicationDecision {
  id            String            @id @default(cuid())
  applicationId String            @unique
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  outcome       ApplicationStatus
  decidedById   String
  decidedBy     User              @relation("DecisionBy", fields: [decidedById], references: [id])
  reason        String?
  publicNote    String?
  snapshot      Json
  createdAt     DateTime          @default(now())
}

model Loan {
  id                String     @id @default(cuid())
  number            String     @unique
  applicationId     String     @unique
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  borrowerId        String
  borrower          Borrower   @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  status            LoanStatus @default(APPROVED_UNFUNDED)
  /// Exact decimal string; never a JS float.
  principal         String
  frequency         String
  periods           Int
  firstPaymentDate  DateTime
  interestMethod    String?
  policy            String
  policyConfigured  Boolean    @default(false)
  version           Int        @default(1)
  disbursedAt       DateTime?
  disbursedById     String?
  disbursedBy       User?      @relation("LoanDisbursedBy", fields: [disbursedById], references: [id], onDelete: SetNull)
  settledAt         DateTime?
  defaultedAt       DateTime?
  defaultedById     String?
  defaultedBy       User?      @relation("LoanDefaultedBy", fields: [defaultedById], references: [id], onDelete: SetNull)
  defaultReason     String?
  /// Guarantees at most one disbursement posting per loan.
  disbursementKey   String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  schedule ScheduleEntry[]
  ledger   LedgerEntry[]
  receipts Receipt[]
  attempts PaymentAttempt[]
  custody  CustodyEvent[]
  smsMessages SmsMessage[]
  documents Document[]
  contracts LoanContract[]
  arrangements RepaymentArrangement[]

  @@index([status, updatedAt])
  @@index([borrowerId])
}

/// The approved repayment plan, frozen at approval. One row per installment.
model ScheduleEntry {
  id         String              @id @default(cuid())
  loanId     String
  loan       Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  number     Int
  dueDate    DateTime
  amount     String
  paidAmount String              @default("0.00")
  status     ScheduleEntryStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  reminders RepaymentReminder[]
  collectionAttempts CollectionAttempt[]

  @@unique([loanId, number])
  @@index([loanId, dueDate])
}

model LedgerEntry {
  id                String          @id @default(cuid())
  loanId            String
  loan              Loan            @relation(fields: [loanId], references: [id], onDelete: Restrict)
  type              LedgerEntryType
  /// Signed exact decimal string: positive increases what the borrower owes
  /// (disbursement), negative reduces it (repayment, sale receipt).
  amount            String
  businessDate      DateTime
  method            String
  externalReference String?
  note              String?
  postedById        String
  postedBy          User            @relation("LedgerPostedBy", fields: [postedById], references: [id])
  attemptId         String?         @unique
  createdAt         DateTime        @default(now())

  receipt             Receipt?
  correctionRequests  CorrectionRequest[] @relation("CorrectionOriginal")

  @@index([loanId, createdAt])
}

/// A cashier request to reverse and replace a posted transaction.
model CorrectionRequest {
  id                    String           @id @default(cuid())
  originalLedgerEntryId String
  originalLedgerEntry   LedgerEntry      @relation("CorrectionOriginal", fields: [originalLedgerEntryId], references: [id], onDelete: Restrict)
  proposedValues        Json
  reason                String
  status                CorrectionStatus @default(REQUESTED)
  requestedById         String
  requestedBy           User             @relation("CorrectionRequestedBy", fields: [requestedById], references: [id])
  decidedById           String?
  decidedBy             User?            @relation("CorrectionDecidedBy", fields: [decidedById], references: [id])
  decisionReason        String?
  reversalEntryId       String?          @unique
  replacementEntryId    String?          @unique
  postingKey            String?          @unique
  version               Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([originalLedgerEntryId])
}

model Receipt {
  id            String      @id @default(cuid())
  number        String      @unique
  loanId        String
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  ledgerEntryId String      @unique
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  issuedById    String
  issuedBy      User        @relation("ReceiptIssuedBy", fields: [issuedById], references: [id])
  summary       Json
  createdAt     DateTime    @default(now())

  @@index([loanId, createdAt])
}

/// One money intent. The key is unique, so a replay returns the original result
/// instead of posting a second transaction; the same key with a different body
/// is a conflict.
model PaymentAttempt {
  id             String               @id @default(cuid())
  idempotencyKey String               @unique
  type           PaymentAttemptType
  loanId         String
  loan           Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  initiatedById  String
  initiatedBy    User                 @relation("PaymentAttemptBy", fields: [initiatedById], references: [id])
  requestHash    String
  requestBody    Json
  status         PaymentAttemptStatus @default(PENDING)
  failureReason  String?
  ledgerEntryId  String?              @unique
  committedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([loanId, status])
  @@index([initiatedById, status])
}

model StorageLocation {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  kind      StorageLocationKind
  secure    Boolean             @default(true)
  capacity  Int?
  notes     String?
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  custodyEvents CustodyEvent[]
}

/// Append-only chain of physical collateral hand-offs.
model CustodyEvent {
  id                String           @id @default(cuid())
  assetId           String
  asset             ApplicationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  loanId            String?
  loan              Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  type              CustodyEventType
  businessDate      DateTime
  location          String?
  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  inspectionResult  String?
  conditionNote     String?
  reason            String?
  recordedById      String
  recordedBy        User             @relation("CustodyRecordedBy", fields: [recordedById], references: [id])
  createdAt         DateTime         @default(now())

  @@index([assetId, createdAt])
  @@index([storageLocationId])
}

model ApplicationAsset {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  description   String
  condition     String
  category      String?
  identifier    String?
  sortOrder     Int      @default(0)
  status        AssetStatus @default(PROPOSED)
  /// Draft sale details before a valuation officer confirms disposal.
  saleDraft     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photos     AssetPhoto[]
  valuations Valuation[]
  custody    CustodyEvent[]

  @@index([applicationId])
  @@index([status])
}

model AssetPhoto {
  id         String           @id @default(cuid())
  assetId    String
  asset      ApplicationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime         @default(now())

  @@index([assetId])
}

model ApplicationTerms {
  id               String      @id @default(cuid())
  applicationId    String      @unique
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version          Int         @default(1)
  firstPaymentDate DateTime?
  frequency        String?
  periods          Int?
  interestMethod   String?
  policyConfigured Boolean     @default(false)
  previewJson      Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Valuation {
  id                   String           @id @default(cuid())
  applicationId        String
  application          Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assetId              String
  asset                ApplicationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status               ValuationStatus  @default(REQUESTED)
  amount               String?
  valuationDate        DateTime?
  basis                String?
  borrowerPresent      Boolean?
  loanOfficerId        String?
  loanOfficer          User?            @relation("ValuationLoanOfficer", fields: [loanOfficerId], references: [id], onDelete: SetNull)
  valuationOfficerId   String?
  valuationOfficer     User?            @relation("ValuationOfficer", fields: [valuationOfficerId], references: [id], onDelete: SetNull)
  participatedAt       DateTime?
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([assetId])
  @@index([applicationId])
  @@index([status])
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum ReminderKind {
  DUE_SOON
  DUE_TODAY
  OVERDUE
}

model SmsMessage {
  id          String    @id @default(cuid())
  toPhone     String
  body        String
  status      SmsStatus @default(QUEUED)
  driver      String
  providerRef String?
  error       String?
  borrowerId  String?
  borrower    Borrower? @relation(fields: [borrowerId], references: [id], onDelete: SetNull)
  loanId      String?
  loan        Loan?     @relation(fields: [loanId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  reminder RepaymentReminder?

  @@index([createdAt])
  @@index([borrowerId])
}

/// One row of each kind per installment. The unique key is the idempotency lock.
model RepaymentReminder {
  id              String         @id @default(cuid())
  scheduleEntryId String
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  kind            ReminderKind
  smsMessageId    String?        @unique
  smsMessage      SmsMessage?    @relation(fields: [smsMessageId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@unique([scheduleEntryId, kind])
}

enum DocumentKind {
  LOAN_CONTRACT_SIGNED
  SIGNATURE_IMAGE
  BORROWER_ID
  OTHER
}

enum ContractStatus {
  ISSUED
  SIGNED
  VOID
}

model Document {
  id           String       @id @default(cuid())
  kind         DocumentKind
  borrowerId   String?
  borrower     Borrower?    @relation(fields: [borrowerId], references: [id], onDelete: SetNull)
  loanId       String?
  loan         Loan?        @relation(fields: [loanId], references: [id], onDelete: SetNull)
  filename     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String       @unique
  uploadedById String?
  uploadedBy   User?        @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  signatureFor LoanContract? @relation("ContractSignature")
  signedCopyFor LoanContract? @relation("ContractSignedCopy")

  @@index([borrowerId])
  @@index([loanId])
}

model LoanContract {
  id              String         @id @default(cuid())
  number          String         @unique
  loanId          String
  loan            Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  version         Int            @default(1)
  status          ContractStatus @default(ISSUED)
  bodyHtml        String
  contentSha256   String
  issuedAt        DateTime       @default(now())
  signedAt        DateTime?
  signerName      String?
  signerMethod    String?
  signerIp        String?
  signerUserAgent String?
  signatureDocId  String?        @unique
  signatureDoc    Document?      @relation("ContractSignature", fields: [signatureDocId], references: [id], onDelete: SetNull)
  signedDocId     String?        @unique
  signedDoc       Document?      @relation("ContractSignedCopy", fields: [signedDocId], references: [id], onDelete: SetNull)
  witnessedById   String?
  witnessedBy     User?          @relation("ContractWitness", fields: [witnessedById], references: [id], onDelete: SetNull)
  voidedAt        DateTime?
  voidReason      String?

  @@unique([loanId, version])
  @@index([loanId, status])
}

enum ArrangementMethod {
  BANK_AUTOMATIC_PAYMENT
  DIRECT_DEBIT
}

enum ArrangementStatus {
  REQUESTED
  ACTIVE
  CANCELLED
}

/// Borrower authority to collect repayments. The full account number is never stored.
model RepaymentArrangement {
  id                 String              @id @default(cuid())
  loanId             String
  loan               Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  method             ArrangementMethod
  status             ArrangementStatus   @default(REQUESTED)
  accountName        String
  accountNumberLast4 String
  bankName           String?
  requestedById      String
  requestedBy        User                @relation("ArrangementRequestedBy", fields: [requestedById], references: [id])
  consentedById      String
  consentedBy        User                @relation("ArrangementConsentedBy", fields: [consentedById], references: [id])
  consentedAt        DateTime
  consentHow         String
  activatedById      String?
  activatedBy        User?               @relation("ArrangementActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  activatedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attempts CollectionAttempt[]

  @@index([loanId, status])
}

/// One row per arrangement, installment and Auckland collection date. Failures stay here and are not posted.
model CollectionAttempt {
  id               String               @id @default(cuid())
  arrangementId    String
  arrangement      RepaymentArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  scheduleEntryId  String
  scheduleEntry    ScheduleEntry        @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  collectionDate   DateTime
  idempotencyKey   String               @unique
  outcome          String
  failureReason    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([arrangementId, scheduleEntryId, collectionDate])
}
