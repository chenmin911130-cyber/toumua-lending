{
  "name": "@toumua/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --exclude '../../node_modules/**' --exclude '../../../node_modules/**' --env-file=../../.env src/main.ts",
    "start:e2e": "tsx --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && cp -R src/generated dist/generated",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "DATABASE_URL=${TEST_DATABASE_URL} prisma migrate deploy",
    "test": "NODE_ENV=test vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@toumua/contracts": "workspace:*",
    "argon2": "0.43.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.2",
    "nodemailer": "7.0.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
